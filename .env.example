# Chave de API da DeepSeek (Obtenha em: https://platform.deepseek.com)
DEEPSEEK_API_KEY=sua_chave_api_aqui
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Configurações do AnkiConnect (Certifique-se de que o Anki Desktop está aberto com o plugin AnkiConnect)
ANKI_CONNECT_URL=http://localhost:8765
ANKI_DECK_NAME=Inglês
ANKI_MODEL_NAME=Basic

# Voz para síntese de áudio (Edge-TTS)
TTS_VOICE=en-US-ChristopherNeural
